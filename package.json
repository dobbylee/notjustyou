{
  "name": "notjustyou",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run build:cli && pnpm run build:mcp && pnpm run build:sdk && next build",
    "build:cli": "pnpm --filter @notjustyou/cli build",
    "build:mcp": "pnpm --filter @notjustyou/mcp build",
    "build:sdk": "pnpm --filter @notjustyou/sdk-js build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:redis": "vitest run --config vitest.redis.config.ts",
    "verify": "pnpm lint && pnpm test && pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@vercel/analytics": "2.0.1",
    "clsx": "2.1.1",
    "lucide-react": "1.50.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "redis": "6.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "30.1.1",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}

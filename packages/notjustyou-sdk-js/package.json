{
  "name": "@notjustyou/sdk-js",
  "version": "0.1.1",
  "description": "Node.js metadata-only SDK collector for Not Just You AI service surfaces.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dobbylee/notjustyou.git",
    "directory": "packages/notjustyou-sdk-js"
  },
  "homepage": "https://github.com/dobbylee/notjustyou#readme",
  "bugs": {
    "url": "https://github.com/dobbylee/notjustyou/issues"
  },
  "keywords": [
    "ai-status",
    "sdk",
    "collector",
    "notjustyou"
  ],
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "pack:dry-run": "pnpm pack --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22 <25"
  }
}

{
  "name": "@notjustyou/cli",
  "version": "0.3.3",
  "description": "Command line status lookup and opt-in local reporting setup for Not Just You AI service surfaces.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dobbylee/notjustyou.git",
    "directory": "packages/notjustyou-cli"
  },
  "homepage": "https://github.com/dobbylee/notjustyou#readme",
  "bugs": {
    "url": "https://github.com/dobbylee/notjustyou/issues"
  },
  "keywords": [
    "ai-status",
    "status",
    "cli",
    "notjustyou"
  ],
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./reporting-setup": {
      "types": "./dist/reporting-setup.d.ts",
      "import": "./dist/reporting-setup.js"
    }
  },
  "bin": {
    "njy": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "pack:dry-run": "pnpm pack --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22 <25"
  }
}

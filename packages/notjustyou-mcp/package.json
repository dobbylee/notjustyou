{
  "name": "@notjustyou/mcp",
  "version": "0.2.6",
  "description": "MCP server for Not Just You AI service status lookup and explicit local reporting setup.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dobbylee/notjustyou.git",
    "directory": "packages/notjustyou-mcp"
  },
  "homepage": "https://github.com/dobbylee/notjustyou#readme",
  "bugs": {
    "url": "https://github.com/dobbylee/notjustyou/issues"
  },
  "keywords": [
    "ai-status",
    "mcp",
    "status",
    "notjustyou"
  ],
  "dependencies": {
    "@notjustyou/cli": "workspace:*"
  },
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "notjustyou-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "node -e \"if (!String(process.env.npm_config_user_agent || '').startsWith('pnpm/')) throw new Error('Use pnpm publish so workspace dependencies are packed with concrete versions.')\"",
    "prepack": "pnpm run build",
    "pack:dry-run": "pnpm pack --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22 <25"
  }
}

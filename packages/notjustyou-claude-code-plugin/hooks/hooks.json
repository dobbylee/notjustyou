{
  "description": "Forward metadata-only Claude Code failure hooks to the local Not Just You receiver.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/setup-reporting.mjs",
              "${user_config.enableReporting}"
            ],
            "timeout": 2
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/forward-local-hook.mjs"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
